# Identifiants France Travail (à obtenir sur https://francetravail.io — voir README).
# Tant que ces deux valeurs sont vides, l'app fonctionne avec des offres de démonstration.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Ne changez ces valeurs que si France Travail modifie ses endpoints publics.
FT_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
FT_SCOPE=api_offresdemploiv2 o2dsoffre
FT_BASE_URL=https://api.francetravail.io

# Port HTTP du serveur.
PORT=3000

# Expression cron de la tâche planifiée de synchronisation (par défaut : toutes les 6h).
SYNC_CRON=0 */6 * * *

# Chemin du fichier SQLite (par défaut : server/data/app.db).
DB_PATH=
